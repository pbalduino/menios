digraph IssueDependencies {
    // Graph styling
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style=filled, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=8];

    // Color coding by category
    subgraph cluster_foundation {
        label="Foundation & Core";
        style=filled;
        fillcolor="#E8F4FD";

        // Memory Management (some completed)
        issue35 [label="#35: kmalloc\nimplementation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue57 [label="#57: VM manager\n(vm_map/vm_unmap)", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue89 [label="#89: mmap/munmap\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue97 [label="#97: Architecture\nabstraction layer", fillcolor="#E6F3FF"];

        // Process Management (some completed)
        issue93 [label="#93: fork/exec\nprocess creation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue34 [label="#34: Preemptive\nscheduler", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_sync {
        label="Synchronization";
        style=filled;
        fillcolor="#F0F8E8";

        issue36 [label="#36: mutex\nimplementation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue37 [label="#37: semaphore", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue39 [label="#39: read-write locks", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue40 [label="#40: condition variables", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_threading {
        label="Threading Support";
        style=filled;
        fillcolor="#E6F7FF";

        issue108 [label="#108: kernel threading\ninfrastructure", fillcolor="#B3E5FC"];
        issue109 [label="#109: pthread API\nand POSIX threading", fillcolor="#B3E5FC"];
        issue110 [label="#110: thread-safe\nC library (libc)", fillcolor="#B3E5FC"];
        issue111 [label="#111: advanced pthread\nsynchronization", fillcolor="#B3E5FC"];
        issue112 [label="#112: thread debugging\nand profiling", fillcolor="#B3E5FC"];
        issue113 [label="#113: thread-aware\nsystem calls", fillcolor="#B3E5FC"];
    }

    subgraph cluster_io {
        label="I/O & File System";
        style=filled;
        fillcolor="#FFF8DC";

        issue96 [label="#96: File descriptor\nmanagement", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue60 [label="#60: Filesystem\nsyscalls", fillcolor="#FFE4B5"];
        issue65 [label="#65: VFS layer", fillcolor="#FFE4B5"];
    }

    subgraph cluster_ipc {
        label="IPC Mechanisms";
        style=filled;
        fillcolor="#F5F0FF";

        issue102 [label="#102: pipes\n(pipe/mkfifo)", fillcolor="#E6E6FA"];
        issue103 [label="#103: UNIX signals", fillcolor="#E6E6FA"];
        issue104 [label="#104: shared memory\n(shmget/shmat)", fillcolor="#E6E6FA"];
        issue105 [label="#105: Unix domain\nsockets", fillcolor="#E6E6FA"];
        issue106 [label="#106: microkernel\nIPC", fillcolor="#DDA0DD"];
        issue107 [label="#107: capability-based\nsecurity", fillcolor="#DDA0DD"];
    }

    subgraph cluster_net {
        label="Networking";
        style=filled;
        fillcolor="#E8F8F5";

        issue67 [label="#67: Network driver\n(e1000/virtio-net)", fillcolor="#B2DFDB"];
        issue68 [label="#68: Ethernet/ARP", fillcolor="#B2DFDB"];
        issue69 [label="#69: IPv4/ICMP", fillcolor="#B2DFDB"];
        issue70 [label="#70: UDP/TCP", fillcolor="#B2DFDB"];
        issue71 [label="#71: Socket API", fillcolor="#B2DFDB"];
    }

    subgraph cluster_smp {
        label="SMP Support";
        style=filled;
        fillcolor="#FFF0F5";

        issue80 [label="#80: per-CPU data", fillcolor="#FFB6C1"];
        issue81 [label="#81: APIC/MADT\nCPU enumeration", fillcolor="#FFB6C1"];
        issue82 [label="#82: AP startup", fillcolor="#FFB6C1"];
        issue83 [label="#83: SMP scheduler", fillcolor="#FFB6C1"];
        issue84 [label="#84: interrupt\ndistribution", fillcolor="#FFB6C1"];
    }

    subgraph cluster_alloc {
        label="Advanced Allocation";
        style=filled;
        fillcolor="#F0FFF0";

        issue87 [label="#87: jemalloc\nresearch", fillcolor="#98FB98"];
        issue88 [label="#88: TLS\ninfrastructure", fillcolor="#98FB98"];
        issue90 [label="#90: jemalloc-inspired\nallocator", fillcolor="#98FB98"];
        issue91 [label="#91: jemalloc port", fillcolor="#98FB98"];
        issue95 [label="#95: userspace\nmalloc/free", fillcolor="#98FB98"];
    }

    subgraph cluster_timers {
        label="Timers & Hardware";
        style=filled;
        fillcolor="#FFFAF0";

        issue101 [label="#101: LAPIC/HPET\ntimer integration", fillcolor="#F0E68C"];
    }

    subgraph cluster_unicode {
        label="Unicode & Internationalization";
        style=filled;
        fillcolor="#F0F8FF";

        issue127 [label="#127: UTF-8 encoding/\ndecoding utilities", fillcolor="#E6F3FF"];
        issue128 [label="#128: Unicode font\nsystem (BDF conversion)", fillcolor="#E6F3FF"];
        issue129 [label="#129: Unicode text\nrendering (framebuffer)", fillcolor="#E6F3FF"];
        issue130 [label="#130: Unicode keyboard\ninput processing", fillcolor="#E6F3FF"];
        issue131 [label="#131: Unicode\nnormalization & processing", fillcolor="#E6F3FF"];
        issue132 [label="#132: Filesystem\nUnicode filename support", fillcolor="#E6F3FF"];
        issue133 [label="#133: Locale/i18n\nframework", fillcolor="#E6F3FF"];
        issue134 [label="#134: Unicode testing\nand validation", fillcolor="#E6F3FF"];
    }

    subgraph cluster_testing {
        label="Testing & Quality Assurance";
        style=filled;
        fillcolor="#F5F5DC";

        issue135 [label="#135: Code coverage\nreporting (Gcov)", fillcolor="#DDDAAA"];
    }

    subgraph cluster_devices {
        label="Device Filesystem & /dev";
        style=filled;
        fillcolor="#F0E68C";

        issue136 [label="#136: Device filesystem\ninfrastructure", fillcolor="#DAA520"];
        issue137 [label="#137: /dev/null and\n/dev/zero devices", fillcolor="#DAA520"];
        issue138 [label="#138: /dev/console and\nterminal devices", fillcolor="#DAA520"];
        issue139 [label="#139: /dev/random and\n/dev/urandom", fillcolor="#DAA520"];
        issue140 [label="#140: /dev/kbd0 and\n/dev/fb0 devices", fillcolor="#DAA520"];
        issue141 [label="#141: /dev/sda block\ndevices", fillcolor="#DAA520"];
        issue142 [label="#142: /dev/ttyS0 serial\ndevice", fillcolor="#DAA520"];
    }

    subgraph cluster_storage {
        label="Additional Storage Drivers";
        style=filled;
        fillcolor="#FFEFD5";

        issue118 [label="#118: IDE/PATA\ncontroller driver", fillcolor="#F5DEB3"];
        issue119 [label="#119: IDE device\ninitialization", fillcolor="#F5DEB3"];
        issue120 [label="#120: IDE interrupt\nhandling", fillcolor="#F5DEB3"];
    }

    subgraph cluster_usb {
        label="USB Support";
        style=filled;
        fillcolor="#E0FFFF";

        issue121 [label="#121: USB host\ncontroller (xHCI/EHCI)", fillcolor="#AFEEEE"];
        issue122 [label="#122: USB device\nmanagement", fillcolor="#AFEEEE"];
        issue123 [label="#123: USB transfer\nmanagement", fillcolor="#AFEEEE"];
        issue124 [label="#124: USB hub\ndriver", fillcolor="#AFEEEE"];
        issue125 [label="#125: USB HID\nclass driver", fillcolor="#AFEEEE"];
        issue126 [label="#126: USB mass\nstorage class", fillcolor="#AFEEEE"];
    }

    // Foundation dependencies (completed foundations)
    issue35 -> issue57 [style=dashed, color=gray];
    issue57 -> issue89 [style=dashed, color=gray];
    issue57 -> issue93 [style=dashed, color=gray];
    issue57 -> issue104 [style=dashed, color=gray];
    issue89 -> issue95 [style=dashed, color=gray];
    issue89 -> issue87 [style=dashed, color=gray];
    issue97 -> issue98 [label="#98: ARM64 port"];

    // Process management dependencies
    issue93 -> issue94 [label="#94: signals", style=dashed, color=gray];
    issue34 -> issue36 [style=dashed, color=gray];
    issue34 -> issue83 [style=dashed, color=gray];

    // Threading dependencies (NEW)
    issue34 -> issue108 [color=blue, penwidth=2, label="enables", style=dashed];
    issue36 -> issue108 [color=blue, penwidth=2, label="enables", style=dashed];
    issue57 -> issue108 [color=blue, penwidth=2, label="enables", style=dashed];
    issue108 -> issue109 [color=blue, penwidth=2];
    issue108 -> issue113 [color=blue, penwidth=2];
    issue109 -> issue110 [color=blue, penwidth=2];
    issue109 -> issue111 [color=blue, penwidth=2];
    issue108 -> issue112 [color=blue, penwidth=2];
    issue109 -> issue112 [color=blue, penwidth=2];
    issue111 -> issue112 [color=blue, penwidth=2];
    issue88 -> issue109 [color=blue, label="TLS support"];
    issue94 -> issue109 [color=blue, label="signal integration"];
    issue95 -> issue110 [color=blue, label="thread-safe malloc"];

    // Synchronization chain (some completed)
    issue36 -> issue37 [style=dashed, color=gray];
    issue36 -> issue39 [style=dashed, color=gray];
    issue36 -> issue40 [style=dashed, color=gray];
    issue40 -> issue102 [style=dashed, color=gray];
    issue40 -> issue104 [style=dashed, color=gray];
    issue40 -> issue105 [style=dashed, color=gray];

    // File descriptor dependencies (filesystem complete)
    issue96 -> issue102 [style=dashed, color=gray];
    issue96 -> issue105 [style=dashed, color=gray];
    issue96 -> issue60 [style=dashed, color=gray];

    // IPC dependencies
    issue102 -> issue106;
    issue104 -> issue106;
    issue101 -> issue103;
    issue101 -> issue106;
    issue93 -> issue103 [style=dashed, color=gray];
    issue106 -> issue107;

    // Networking chain
    issue67 -> issue68;
    issue68 -> issue69;
    issue69 -> issue70;
    issue70 -> issue71;
    issue71 -> issue105;

    // SMP dependencies
    issue80 -> issue81;
    issue81 -> issue82;
    issue82 -> issue83;
    issue83 -> issue84;

    // Memory allocator dependencies
    issue87 -> issue88;
    issue87 -> issue90;
    issue88 -> issue91;
    issue89 -> issue90;
    issue89 -> issue91;
    issue90 -> issue91;
    issue91 -> issue92 [label="#92: benchmarking"];

    // Cross-cutting dependencies
    issue57 -> issue58 [label="#58: VM integration", style=dashed, color=gray];
    issue57 -> issue56 [label="#56: lazy allocation", style=dashed, color=gray];
    issue60 -> issue54 [label="#54: shell evolution"];
    issue71 -> issue72 [label="#72: network utils"];
    issue72 -> issue73 [label="#73: advanced networking"];

    // Hardware/driver dependencies (completed filesystem stack)
    issue114 [label="#114: block device\nabstraction layer", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue115 [label="#115: DMA allocation\nhelpers", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue116 [label="#116: PCI/AHCI\ncontroller init", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue117 [label="#117: AHCI interrupt\nservice path", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue62 [label="#62: AHCI/ATA block\ndevice driver", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue63 [label="#63: block cache", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue64 [label="#64: filesystem\nlibrary (FAT32)", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue65 [label="#65: VFS layer", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue60 [label="#60: filesystem\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

    // Completed filesystem dependencies
    issue114 -> issue62 [style=dashed, color=gray];
    issue115 -> issue116 [style=dashed, color=gray];
    issue116 -> issue117 [style=dashed, color=gray];
    issue117 -> issue62 [style=dashed, color=gray];
    issue115 -> issue62 [style=dashed, color=gray];
    issue62 -> issue63 [style=dashed, color=gray];
    issue63 -> issue64 [style=dashed, color=gray];
    issue64 -> issue65 [style=dashed, color=gray];
    issue65 -> issue60 [style=dashed, color=gray];

    // Graphics and userspace
    issue31 [label="#31: graphics/\nframebuffer", fillcolor="#DEB887"];
    issue32 [label="#32: input\nsubsystem", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    issue33 [label="#33: audio\nsubsystem", fillcolor="#DEB887"];

    issue96 -> issue31 [style=dashed, color=gray];
    issue96 -> issue32 [style=dashed, color=gray];
    issue96 -> issue33 [style=dashed, color=gray];

    // Unicode dependencies (NEW)
    issue127 -> issue128 [color=green, penwidth=2];
    issue127 -> issue129 [color=green, penwidth=2];
    issue127 -> issue130 [color=green, penwidth=2];
    issue127 -> issue131 [color=green, penwidth=2];
    issue127 -> issue132 [color=green, penwidth=2];
    issue128 -> issue129 [color=green, penwidth=2];
    issue129 -> issue130 [color=green, penwidth=2];
    issue131 -> issue132 [color=green, penwidth=2];
    issue131 -> issue133 [color=green, penwidth=2];
    issue127 -> issue134 [color=green, penwidth=1];
    issue128 -> issue134 [color=green, penwidth=1];
    issue129 -> issue134 [color=green, penwidth=1];
    issue130 -> issue134 [color=green, penwidth=1];
    issue131 -> issue134 [color=green, penwidth=1];
    issue132 -> issue134 [color=green, penwidth=1];
    issue133 -> issue134 [color=green, penwidth=1];

    // Integration dependencies
    issue31 -> issue129 [color=green, label="framebuffer integration"];
    issue32 -> issue130 [color=green, label="input integration"];
    issue60 -> issue132 [color=green, label="filesystem integration"];

    // Testing and code coverage dependencies
    issue134 -> issue135 [color=orange, label="test coverage analysis"];
    issue135 -> issue127 [color=orange, label="coverage feedback", style=dashed];
    issue135 -> issue128 [color=orange, label="coverage feedback", style=dashed];
    issue135 -> issue129 [color=orange, label="coverage feedback", style=dashed];

    // IDE storage dependencies
    issue118 -> issue119 [color=brown, penwidth=2];
    issue119 -> issue120 [color=brown, penwidth=2];
    issue114 -> issue118 [color=brown, style=dashed];

    // USB dependencies
    issue121 -> issue122 [color=cyan, penwidth=2];
    issue122 -> issue123 [color=cyan, penwidth=2];
    issue123 -> issue124 [color=cyan, penwidth=2];
    issue122 -> issue125 [color=cyan, penwidth=2];
    issue122 -> issue126 [color=cyan, penwidth=2];
    issue125 -> issue32 [color=cyan, label="USB input"];
    issue126 -> issue63 [color=cyan, label="USB storage"];

    // Device filesystem dependencies (NEW)
    issue96 -> issue136 [color=gold, penwidth=2, label="file descriptors"];
    issue60 -> issue136 [color=gold, penwidth=2, label="VFS integration"];
    issue136 -> issue137 [color=gold, penwidth=2];
    issue136 -> issue138 [color=gold, penwidth=2];
    issue136 -> issue139 [color=gold, penwidth=2];
    issue136 -> issue140 [color=gold, penwidth=2];
    issue136 -> issue141 [color=gold, penwidth=2];
    issue136 -> issue142 [color=gold, penwidth=2];

    // Device hardware integration
    issue31 -> issue140 [color=gold, label="framebuffer integration"];
    issue32 -> issue140 [color=gold, label="keyboard integration"];
    issue62 -> issue141 [color=gold, label="AHCI integration"];
    issue31 -> issue138 [color=gold, label="console integration"];

    // Critical path highlighting (filesystem complete, threading ready)
    edge [color=red, penwidth=3];
    issue89 -> issue95 [label="CRITICAL", style=dashed];
    issue96 -> issue102 [label="CRITICAL", style=dashed];
    issue108 -> issue109 [label="THREADING CRITICAL"];
    issue60 -> issue31 [label="GRAPHICS READY", color=purple];
    issue127 -> issue128 [label="UNICODE START", color=green];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#F9F9F9";

        legend_open [label="Open Issue", fillcolor="#FFE6E6"];
        legend_closed [label="Closed Issue", fillcolor="#90EE90", style="filled,dashed"];
        legend_threading [label="New Threading", fillcolor="#B3E5FC"];
        legend_unicode [label="Unicode Support", fillcolor="#E6F3FF"];
        legend_testing [label="Testing & QA", fillcolor="#DDDAAA"];
        legend_ide [label="IDE Storage", fillcolor="#F5DEB3"];
        legend_usb [label="USB Support", fillcolor="#AFEEEE"];
