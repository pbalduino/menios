digraph HardwareInfrastructure {
    // Graph styling
    rankdir=TB;
    ranksep=1.2;
    nodesep=0.7;
    bgcolor="white";
    node [shape=box, style=filled, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=8];

    // Title
    labelloc="t";
    label="Hardware Infrastructure - ACPI, PCI, Drivers & Networking";
    fontsize=16;
    fontname="Arial Bold";

    // PCI Foundation (complete)
    subgraph cluster_pci_complete {
        label="PCI Infrastructure ✅ COMPLETE";
        style=filled;
        fillcolor="#E8F8E8";

        issue335 [label="#335: PNP0A08\nPCI host bridge", fillcolor="#90EE90", style="filled,dashed"];
        issue280 [label="#280: PCI config\nspace API", fillcolor="#90EE90", style="filled,dashed"];
    }

    // ACPI/UACPI
    subgraph cluster_acpi {
        label="ACPI & uACPI Integration";
        style=filled;
        fillcolor="#E6F3FF";

        issue276 [label="#276: UACPI kernel interface\n22/22 complete (100%)\n\n✅ Events, sleep, ticks\n✅ PCI / IO / memory accessors\n✅ SCI interrupts & deferred work", fillcolor="#90EE90", style="filled,dashed"];
    }

    // Kernel Infrastructure (complete)
    subgraph cluster_missing {
        label="Kernel Infrastructure ✅";
        style=filled;
        fillcolor="#E8F8E8";

        issue278 [label="#278: Work queue system\n✅ deferred work", fillcolor="#90EE90", style="filled,dashed"];
        issue279 [label="#279: Dynamic IRQ\n✅ handler registration", fillcolor="#90EE90", style="filled,dashed"];
        issue281 [label="#281: I/O port\n✅ resource manager", fillcolor="#90EE90", style="filled,dashed"];
    }

    // Drivers
    subgraph cluster_drivers {
        label="Device Drivers";
        style=filled;
        fillcolor="#FFF8E1";

        issue67 [label="#67: e1000 network driver\nInterrupt-driven NIC\n\nReady to implement\n10-12 weeks", fillcolor="#FFE4B5"];
        issue336 [label="#336: termios\nTTY line discipline\n\n✅ Ready to implement\n9-13 weeks", fillcolor="#B3E5FC"];
    }

    // Audio Subsystem
    subgraph cluster_audio {
        label="Audio Subsystem (Doom)";
        style=filled;
        fillcolor="#FFE4F0";

        issue33 [label="#33: Audio subsystem\nParent issue\n\nReady after driver/core\n9-12 weeks", fillcolor="#FFB6E8"];
        issue382 [label="#382: AC'97 audio driver\nDMA interrupts\n\nReady to implement\n2-3 weeks", fillcolor="#FFE4B5"];
        issue383 [label="#383: Kernel audio core\nInterrupt notification\n\nReady to implement\n2-3 weeks", fillcolor="#FFE4B5"];
    }

    // Future networking
    subgraph cluster_network {
        label="Networking Stack (Future)";
        style=filled;
        fillcolor="#F0F0FF";

        tcpip [label="TCP/IP Stack\n(not yet tracked)", fillcolor="#E6E6FA"];
        issue341 [label="#341: Socket API\nsocket/bind/connect", fillcolor="#E6E6FA"];
    }

    // PCI dependencies
    issue335 -> issue280 [label="PCI root → config", color=green, penwidth=2, style=dashed];
    issue280 -> issue276 [label="config → UACPI", color=green, penwidth=2, style=dashed];

    // UACPI blockers
    issue278 -> issue276 [label="work queue\nfor schedule_work", color=green, penwidth=2, style=dashed];
    issue279 -> issue276 [label="IRQ handlers\nfor interrupts", color=green, penwidth=2, style=dashed];
    issue281 -> issue276 [label="I/O port mgmt\nfor I/O ops", color=green, penwidth=2, style=dashed];

    // e1000 dependencies
    issue335 -> issue67 [label="PCI enumeration ✅", color=green, penwidth=2, style=dashed];
    issue280 -> issue67 [label="PCI config ✅", color=green, penwidth=2, style=dashed];
    issue279 -> issue67 [label="IRQ support\navailable", color=green, penwidth=2, style=dashed];

    // Audio subsystem dependencies
    issue335 -> issue382 [label="PCI enumeration ✅", color=green, penwidth=2, style=dashed];
    issue280 -> issue382 [label="PCI config ✅", color=green, penwidth=2, style=dashed];
    issue279 -> issue382 [label="IRQ support\navailable", color=green, penwidth=2, style=dashed];
    issue279 -> issue383 [label="IRQ support\navailable", color=green, penwidth=2, style=dashed];
    issue382 -> issue33 [label="driver ready", color=purple, penwidth=2];
    issue383 -> issue33 [label="core ready", color=purple, penwidth=2];

    // Networking stack
    issue67 -> tcpip [label="NIC driver → TCP/IP", color=purple, style=dotted];
    tcpip -> issue341 [label="TCP/IP → sockets", color=purple, style=dotted];

    // termios (ready now)
    // No blockers shown - all dependencies satisfied

    // Status summary
    subgraph cluster_status {
        label="Current Status";
        style=filled;
        fillcolor="#FFFACD";

        status [label="✅ PCI Infrastructure: COMPLETE (#335, #280)\n✅ UACPI kernel interface: COMPLETE (#276)\n✅ Work queue / deferred execution: COMPLETE (#278)\n✅ Dynamic IRQ subsystem: COMPLETE (#279)\n✅ I/O port manager: COMPLETE (#281)\n\nNext focus:\n• #67 e1000 network driver\n• #33 Audio subsystem (AC'97 + core)\n• #336 termios line discipline",
               shape=note, fillcolor="#FFFACD", style=filled];
    }

    // Priority
    subgraph cluster_priority {
        label="Implementation Priority";
        style=filled;
        fillcolor="#E8F8FF";

        priority [label="Current Priorities:\n\n1. #67 (e1000 driver) - 10-12 weeks\n   → Networking enablement, now unblocked\n\n2. Audio stack (#382 + #383 + #33) - 9-12 weeks\n   → Doom audio milestone\n\n3. #336 (termios) - 9-13 weeks\n   → Improves TTY UX\n\nFoundation complete:\n• Work queue (#278)\n• Dynamic IRQ (#279)\n• I/O port manager (#281)",
                shape=note, fillcolor="#E8F8FF", style=filled];
    }

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#F9F9F9";

        legend_complete [label="Complete ✅", fillcolor="#90EE90", style="filled,dashed"];
        legend_ready [label="Ready to Start", fillcolor="#B3E5FC"];
        legend_blocker [label="Blocking Issue ⚠️", fillcolor="#FFB6C1"];
        legend_progress [label="In Progress", fillcolor="#FFE4B5"];
        legend_future [label="Future", fillcolor="#E6E6FA"];
    }
}
