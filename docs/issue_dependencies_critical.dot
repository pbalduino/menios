digraph CriticalPath {
    // Graph styling
    rankdir=LR;
    ranksep=1.2;
    nodesep=0.8;
    bgcolor="white";
    node [shape=box, style=filled, fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=9];

    // Title
    labelloc="t";
    label="Critical Path to TCC/GCC Native Compilation";
    fontsize=16;
    fontname="Arial Bold";

    // Foundation (complete)
    subgraph cluster_foundation {
        label="Foundation ✅ COMPLETE";
        style=filled;
        fillcolor="#E8F8E8";

        issue193 [label="#193: Minimal libc", fillcolor="#90EE90", style="filled,dashed"];
        issue29 [label="#29: Cross-compiler\ntoolchain", fillcolor="#90EE90", style="filled,dashed"];
        issue213 [label="#213: Signal\ndelivery", fillcolor="#90EE90", style="filled,dashed"];
        issue310 [label="#310: Basic math\n(fabs)", fillcolor="#90EE90", style="filled,dashed"];
        issue208 [label="#208: Pipes", fillcolor="#90EE90", style="filled,dashed"];
        issue189 [label="#189: FAT32\nwrite", fillcolor="#90EE90", style="filled,dashed"];
    }

    // TCC Blockers (CRITICAL)
    subgraph cluster_blockers {
        label="TCC Blockers ⚠️ CRITICAL";
        style=filled;
        fillcolor="#FFE4E4";

        issue337 [label="#337: Signal API\nsigaction/sigemptyset\n\n5-6 weeks", fillcolor="#FFB6C1"];
        issue338 [label="#338: Float parsing\nstrtod/ldexp\n\n8-11 weeks", fillcolor="#FFB6C1"];
    }

    // Native Compilation
    subgraph cluster_native {
        label="Native Compilation";
        style=filled;
        fillcolor="#E6F3FF";

        issue190 [label="#190: TCC port\n\n4-6 weeks\n\nBLOCKED", fillcolor="#FFE4B5"];
        issue191 [label="#191: binutils port\n\n6-8 weeks\n\nReady", fillcolor="#B3E5FC"];
    }

    // Dependencies - Foundation to blockers
    issue213 -> issue337 [label="kernel signals", color=red, penwidth=2, style=dashed];
    issue193 -> issue337 [label="libc", color=red, penwidth=2, style=dashed];

    issue310 -> issue338 [label="basic math", color=red, penwidth=2, style=dashed];
    issue193 -> issue338 [label="libc", color=red, penwidth=2, style=dashed];

    // Blockers to TCC
    issue337 -> issue190 [label="BLOCKS\nTCC", color=red, penwidth=4];
    issue338 -> issue190 [label="BLOCKS\nTCC", color=red, penwidth=4];

    // Foundation to TCC (already satisfied)
    issue29 -> issue190 [label="toolchain ✅", color=green, penwidth=2, style=dashed];
    issue193 -> issue190 [label="libc ✅", color=green, penwidth=2, style=dashed];
    issue208 -> issue190 [label="pipes ✅", color=green, penwidth=2, style=dashed];
    issue189 -> issue190 [label="file I/O ✅", color=green, penwidth=2, style=dashed];

    // Foundation to binutils (already satisfied)
    issue29 -> issue191 [label="toolchain ✅", color=green, penwidth=2, style=dashed];
    issue193 -> issue191 [label="libc ✅", color=green, penwidth=2, style=dashed];
    issue189 -> issue191 [label="file I/O ✅", color=green, penwidth=2, style=dashed];

    // TCC and binutils relationship
    issue191 -> issue190 [label="linker/assembler", color=blue, style=dotted];

    // Timeline annotation
    subgraph cluster_timeline {
        label="Timeline";
        style=filled;
        fillcolor="#F9F9F9";

        timeline [label="Total to TCC: 19-26 weeks\n\nPhase 1: Signal API (5-6 weeks)\nPhase 2: Float parsing (8-11 weeks)\nPhase 3: TCC port (4-6 weeks)\n\nbinutils: Ready now (parallel track)",
                 shape=note, fillcolor="#FFFACD", style=filled];
    }

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#F9F9F9";

        legend_complete [label="Complete ✅", fillcolor="#90EE90", style="filled,dashed"];
        legend_blocker [label="TCC Blocker ⚠️", fillcolor="#FFB6C1"];
        legend_ready [label="Ready to Start", fillcolor="#B3E5FC"];
        legend_blocked [label="Blocked", fillcolor="#FFE4B5"];
    }
}
