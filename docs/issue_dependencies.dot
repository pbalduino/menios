digraph IssueDependencies {
    // Graph styling
    rankdir=TB;
    ranksep=1.5;
    nodesep=0.5;
    bgcolor="white";
    node [shape=box, style=filled, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=8];

    // Color coding by category
    subgraph cluster_foundation {
        label="Foundation & Core";
        style=filled;
        fillcolor="#E8F4FD";

        // Memory Management (some completed)
        issue35 [label="#35: kmalloc\nimplementation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue57 [label="#57: VM manager\n(vm_map/vm_unmap)", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue89 [label="#89: mmap/munmap\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue97 [label="#97: Architecture\nabstraction layer", fillcolor="#E6F3FF"];

        // Process Management (some completed)
        issue93 [label="#93: fork/exec\nprocess creation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue34 [label="#34: Preemptive\nscheduler", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue148 [label="#148: Environment\nvariables support", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue147 [label="#147: getcwd/chdir\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_sync {
        label="Synchronization";
        style=filled;
        fillcolor="#F0F8E8";

        issue36 [label="#36: mutex\nimplementation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue37 [label="#37: semaphore", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue39 [label="#39: read-write locks", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue40 [label="#40: condition variables", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_threading {
        label="Threading Support";
        style=filled;
        fillcolor="#E6F7FF";

        issue108 [label="#108: kernel threading\ninfrastructure", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue109 [label="#109: pthread API\nand POSIX threading", fillcolor="#B3E5FC"];
        issue110 [label="#110: thread-safe\nC library (libc)", fillcolor="#B3E5FC"];
        issue111 [label="#111: advanced pthread\nsynchronization", fillcolor="#B3E5FC"];
        issue112 [label="#112: thread debugging\nand profiling", fillcolor="#B3E5FC"];
        issue113 [label="#113: thread-aware\nsystem calls", fillcolor="#B3E5FC"];
    }

    subgraph cluster_shell {
        label="Shell & Utilities";
        style=filled;
        fillcolor="#FFF5EE";

        // Core shell functionality
        issue54 [label="#54: mosh as\ndefault shell", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue161 [label="#161: Basic REPL\nand parsing", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue162 [label="#162: Command\nexecution", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue163 [label="#163: Built-in\ncommands", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue224 [label="#224: unset\nbuilt-in", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

        // I/O and pipelines
        issue164 [label="#164: Basic I/O\nredirection", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue159 [label="#159: Advanced\nredirection", fillcolor="#FFF5EE"];
        issue204 [label="#204: Logical\noperators", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

        // Environment and utilities
        issue180 [label="#180: Environment\nseeding in init", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue181 [label="#181: tmpfs\nvalidation", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue182 [label="#182: waitpid\nregression test", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue183 [label="#183: /bin\nutilities", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue184 [label="#184: Line editor\ncoverage", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue185 [label="#185: PATH\nsearch", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue186 [label="#186: Pipeline\nplaceholders", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue187 [label="#187: ps/kill\nutilities", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue188 [label="#188: env\nutility", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

        // Advanced features
        issue155 [label="#155: Scripting\nsupport", fillcolor="#DDA0DD"];
        issue158 [label="#158: Job control\nbg/fg/Ctrl-Z", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue166 [label="#166: Virtual\nterminal I/O", fillcolor="#DDA0DD"];
    }

    subgraph cluster_shell_ux {
        label="Shell UX Features";
        style=filled;
        fillcolor="#F0FFFF";

        issue160 [label="#160: Line editing\nkeys", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue197 [label="#197: Tab\ncompletion", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue198 [label="#198: Ctrl+A/E\nline nav", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue199 [label="#199: Ctrl+R\nreverse search", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue200 [label="#200: Ctrl+L\nclear screen", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue201 [label="#201: Mouse\nselection", fillcolor="#E0FFFF"];
        issue222 [label="#222: Current dir\nin prompt", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_toolchain {
        label="Toolchain & Compilation";
        style=filled;
        fillcolor="#FFFAEF";

        issue29 [label="#29: Cross-compiler\ntoolchain", fillcolor="#FFE4B5"];
        issue192 [label="#192: crt0\nruntime", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue193 [label="#193: Minimal\nlibc", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue194 [label="#194: Syscall\nABI docs", fillcolor="#FFE4B5"];
        issue195 [label="#195: Userland\nbuild system", fillcolor="#FFE4B5"];
        issue190 [label="#190: TCC\nport", fillcolor="#DDA0DD"];
        issue191 [label="#191: binutils\nport", fillcolor="#DDA0DD"];
        issue196 [label="#196: Fish shell\nresearch", fillcolor="#DDA0DD"];
    }

    subgraph cluster_io {
        label="I/O & File System";
        style=filled;
        fillcolor="#FFF8DC";

        issue96 [label="#96: File descriptor\nmanagement", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue60 [label="#60: Filesystem\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue65 [label="#65: VFS layer", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue189 [label="#189: FAT32\nwrite support", fillcolor="#FFE4B5"];
        issue205 [label="#205: Elevator\nI/O scheduler", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    subgraph cluster_ipc {
        label="IPC Mechanisms";
        style=filled;
        fillcolor="#F5F0FF";

        // Pipes (parent and breakdown)
        issue102 [label="#102: Pipes/FIFOs\n(parent)", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue206 [label="#206: Pipe data\nstructure", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue207 [label="#207: Pipe\nsyscall API", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue208 [label="#208: Shell\npipelines", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue209 [label="#209: Named\nFIFOs", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

        // Signals (parent and breakdown)
        issue103 [label="#103: UNIX signals\n(parent)", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue210 [label="#210: Signal\nbookkeeping", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue211 [label="#211: Signal\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue212 [label="#212: Signal\ndelivery", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue213 [label="#213: Shell\nCtrl+C", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue214 [label="#214: Advanced\nsignals", fillcolor="#DDA0DD"];

        // Shared Memory (broken down)
        issue215 [label="#215: Shared mem\nmanager", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue216 [label="#216: Shared mem\nsyscalls", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue217 [label="#217: Shared mem\ncleanup", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue218 [label="#218: Shared mem\ntests", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue219 [label="#219: Shared mem\ndocs", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED

        // Other IPC
        issue105 [label="#105: Unix domain\nsockets", fillcolor="#E6E6FA"];
        issue106 [label="#106: microkernel\nIPC", fillcolor="#DDA0DD"];
        issue107 [label="#107: capability-based\nsecurity", fillcolor="#DDA0DD"];
        issue220 [label="#220: ioctl\nsyscall", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue221 [label="#221: Fast syscall\ninstruction", fillcolor="#E6E6FA"];
    }

    subgraph cluster_graphics {
        label="Graphics & Audio (Doom)";
        style=filled;
        fillcolor="#FFE4F0";

        issue31 [label="#31: Userspace\ngraphics interface", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue32 [label="#32: Input\nsubsystem", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
        issue33 [label="#33: Audio\nsubsystem", fillcolor="#FFB6E8"];
    }

    subgraph cluster_system_services {
        label="System Services";
        style=filled;
        fillcolor="#FFF9E6";

        issue225 [label="#225: Cron job\nscheduling", fillcolor="#FFE4B5"];
        issue226 [label="#226: RTC and time\nmanagement", fillcolor="#FFE4B5"];
    }

    subgraph cluster_bugs {
        label="Bug Fixes";
        style=filled;
        fillcolor="#FFE4E4";

        issue202 [label="#202: /dev/zero\nEOF bug", fillcolor="#FFB6C1"];
        issue203 [label="#203: Pipeline\nhang bug", fillcolor="#90EE90", style="filled,dashed"];  // CLOSED
    }

    // Foundation dependencies
    issue35 -> issue57 [style=dashed, color=gray];
    issue57 -> issue89 [style=dashed, color=gray];
    issue57 -> issue93 [style=dashed, color=gray];
    issue89 -> issue95 [label="#95: userspace malloc", style=dashed, color=gray];

    // Threading dependencies
    issue34 -> issue108 [color=blue, penwidth=2, style=dashed];
    issue36 -> issue108 [color=blue, penwidth=2, style=dashed];
    issue57 -> issue108 [color=blue, penwidth=2, style=dashed];
    issue108 -> issue109 [color=blue, penwidth=2, style=dashed];
    issue109 -> issue110 [color=blue, penwidth=2];
    issue109 -> issue111 [color=blue, penwidth=2];
    issue108 -> issue113 [color=blue, penwidth=2, style=dashed];

    // Shell milestone dependencies (some complete)
    issue148 -> issue180 [color=green, penwidth=2, style=dashed];
    issue148 -> issue185 [color=green, penwidth=2, style=dashed];
    issue148 -> issue188 [color=green, penwidth=2, style=dashed];
    issue148 -> issue193 [color=green, penwidth=2, style=dashed];
    issue145 -> issue182 [label="#145: waitpid", color=green];
    issue149 -> issue182 [label="#149: init", color=green];
    issue151 -> issue181 [label="#151: tmpfs", color=green];

    // Toolchain dependencies (some complete)
    issue192 -> issue193 [color=orange, penwidth=2, style=dashed];
    issue148 -> issue193 [color=orange, style=dashed];
    issue192 -> issue195 [color=orange, style=dashed];
    issue193 -> issue195 [color=orange, penwidth=2, style=dashed];
    issue192 -> issue29 [color=orange, style=dashed];
    issue193 -> issue29 [color=orange, style=dashed];
    issue194 -> issue29 [color=orange];
    issue195 -> issue29 [color=orange, penwidth=2];

    // Native compilation dependencies (some complete)
    issue29 -> issue190 [color=purple];
    issue193 -> issue190 [color=purple, style=dashed];
    issue208 -> issue190 [color=purple, label="pipes"];
    issue189 -> issue190 [color=purple];
    issue205 -> issue190 [color=teal, label="I/O perf", style=dashed];
    issue29 -> issue191 [color=purple];
    issue193 -> issue191 [color=purple, style=dashed];
    issue189 -> issue191 [color=purple];
    issue205 -> issue191 [color=teal, label="I/O perf", style=dashed];

    // Shell UX dependencies (some complete)
    issue148 -> issue197 [color=cyan, style=dashed];
    issue147 -> issue197 [color=cyan];
    issue147 -> issue222 [color=cyan];
    issue156 -> issue199 [label="#156: history", color=cyan, style=dashed];
    issue143 -> issue201 [label="#143: PS/2 mouse", color=cyan];
    issue144 -> issue201 [label="#144: USB mouse", color=cyan];

    // Process tools dependencies
    issue213 -> issue187 [color=brown, label="signals for kill", style=dashed];

    // Bug fix relationships
    issue137 -> issue202 [label="#137: /dev/zero", style=dotted];
    issue208 -> issue203 [label="shell pipelines", style=dotted];
    issue165 -> issue203 [label="#165: pipeline", style=dotted];

    // File system write support
    issue60 -> issue189 [style=dashed, color=gray];

    // I/O scheduler dependencies (✅ COMPLETE)
    issue114 -> issue205 [label="#114: block device", style=dashed, color=gray];
    issue62 -> issue205 [label="#62: AHCI", style=dashed, color=gray];
    issue63 -> issue205 [label="#63: cache", style=dashed, color=gray];
    issue205 -> issue189 [color=teal, style=dashed];
    issue205 -> issue190 [color=teal, style=dashed];
    issue205 -> issue191 [color=teal, style=dashed];

    // Pipes dependencies (sequential)
    issue96 -> issue206 [label="#96: fd mgmt", style=dashed, color=gray];
    issue40 -> issue206 [label="#40: condvar", style=dashed, color=gray];
    issue206 -> issue207 [color=purple, penwidth=2, style=dashed];
    issue207 -> issue208 [color=purple, penwidth=2, style=dashed];
    issue208 -> issue209 [color=purple, style=dashed];
    issue65 -> issue209 [label="#65: VFS", style=dashed, color=gray];

    // Signals dependencies (sequential)
    issue93 -> issue210 [label="#93: fork/exec", style=dashed, color=gray];
    issue34 -> issue210 [label="#34: scheduler", style=dashed, color=gray];
    issue210 -> issue211 [color=purple, penwidth=2, style=dashed];
    issue211 -> issue212 [color=purple, penwidth=2, style=dashed];
    issue212 -> issue213 [color=purple, penwidth=2, style=dashed];
    issue213 -> issue214 [color=purple, style=dashed];
    issue109 -> issue214 [label="#109: pthread"];

    // Shared Memory dependencies (sequential)
    issue57 -> issue215 [label="#57: VM", style=dashed, color=gray];
    issue89 -> issue215 [label="#89: mmap", style=dashed, color=gray];
    issue215 -> issue216 [color=purple, penwidth=2];
    issue216 -> issue217 [color=purple, penwidth=2];
    issue217 -> issue218 [color=purple, penwidth=2];
    issue218 -> issue219 [color=purple];

    // IPC integration
    issue208 -> issue106 [label="pipes"];
    issue213 -> issue106 [label="signals"];
    issue217 -> issue106 [label="shmem"];
    issue106 -> issue107;

    // ioctl dependencies
    issue96 -> issue220 [label="#96: fd mgmt", style=dashed, color=gray];
    issue60 -> issue220 [label="#60: file syscalls", style=dashed, color=gray];

    // Parent issue relationships (pipes and signals)
    issue102 -> issue206 [color=purple, style=dashed, label="breakdown"];
    issue103 -> issue210 [color=purple, style=dashed, label="breakdown"];

    // Shell core dependencies
    issue148 -> issue163 [color=green, style=dashed];  // env vars -> built-ins
    issue148 -> issue224 [color=green];  // env vars -> unset
    issue163 -> issue224 [color=green];  // built-ins -> unset
    issue162 -> issue54 [color=green, style=dashed];  // command exec -> mosh default
    issue161 -> issue162 [color=green, style=dashed];  // REPL -> command exec
    issue164 -> issue159 [color=green];  // basic I/O -> advanced I/O
    issue208 -> issue204 [color=green, style=dashed];  // pipelines -> logical operators
    issue158 -> issue187 [color=green, style=dashed];  // job control -> ps/kill

    // Shell UX line editing progression
    issue160 -> issue198 [color=cyan, style=dashed];  // line editing keys -> Ctrl+A/E

    // Cron dependencies
    issue226 -> issue225 [color=brown, penwidth=2, label="time syscalls"];  // RTC/time -> cron
    issue213 -> issue225 [color=brown, label="signals"];  // Ctrl+C signals -> cron
    issue96 -> issue225 [color=brown, label="file I/O"];  // fd mgmt -> cron
    issue148 -> issue225 [color=brown, label="env vars"];  // env -> cron

    // Graphics/Audio dependencies (for Doom)
    issue96 -> issue31 [color=purple, style=dashed];  // fd mgmt -> graphics
    issue32 -> issue31 [color=purple];  // input -> graphics

    // Critical path highlighting
    edge [color=red, penwidth=3];
    issue192 -> issue193 [label="TOOLCHAIN\nCRITICAL"];
    issue193 -> issue29 [label="TOOLCHAIN\nCRITICAL"];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#F9F9F9";

        legend_open [label="Open Issue", fillcolor="#FFE6E6"];
        legend_closed [label="Closed Issue", fillcolor="#90EE90", style="filled,dashed"];
        legend_shell [label="Shell Milestone", fillcolor="#FFE4B5"];
        legend_toolchain [label="Toolchain", fillcolor="#FFE4B5"];
        legend_ux [label="UX Features", fillcolor="#E0FFFF"];
        legend_bugs [label="Bugs", fillcolor="#FFB6C1"];
    }
}
