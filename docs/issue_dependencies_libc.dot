digraph LibcEcosystem {
    // Graph styling
    rankdir=TB;
    ranksep=1.0;
    nodesep=0.6;
    bgcolor="white";
    node [shape=box, style=filled, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=8];

    // Title
    labelloc="t";
    label="libc Ecosystem - Standard Library Implementation";
    fontsize=16;
    fontname="Arial Bold";

    // Foundation
    subgraph cluster_foundation {
        label="Foundation ✅ COMPLETE";
        style=filled;
        fillcolor="#E8F8E8";

        issue193 [label="#193: Minimal libc\nBASIC FUNCTIONALITY", fillcolor="#90EE90", style="filled,dashed"];
        issue213 [label="#213: Signal delivery", fillcolor="#90EE90", style="filled,dashed"];
        issue109 [label="#109: pthread API", fillcolor="#B3E5FC"];
        issue208 [label="#208: Pipes", fillcolor="#90EE90", style="filled,dashed"];
        issue336 [label="#336: termios\nline discipline", fillcolor="#FFE4B5"];
    }

    // Doom libc (complete)
    subgraph cluster_doom_libc {
        label="Doom libc Gaps ✅ ALL COMPLETE";
        style=filled;
        fillcolor="#E8FFE8";

        issue304 [label="#304: scanf family", fillcolor="#90EE90", style="filled,dashed"];
        issue305 [label="#305: File stdio", fillcolor="#90EE90", style="filled,dashed"];
        issue306 [label="#306: Filesystem helpers", fillcolor="#90EE90", style="filled,dashed"];
        issue307 [label="#307: Environment", fillcolor="#90EE90", style="filled,dashed"];
        issue308 [label="#308: String utilities", fillcolor="#90EE90", style="filled,dashed"];
        issue309 [label="#309: Formatted I/O", fillcolor="#90EE90", style="filled,dashed"];
        issue310 [label="#310: Basic math (fabs)", fillcolor="#90EE90", style="filled,dashed"];
    }

    // TCC blockers - NOW COMPLETE!
    subgraph cluster_tcc_blockers {
        label="TCC Blockers ✅ COMPLETE!";
        style=filled;
        fillcolor="#E8F8E8";

        issue337 [label="#337: Signal API\nsigaction/sigemptyset\n\n✅ COMPLETE", fillcolor="#90EE90", style="filled,dashed"];
        issue338 [label="#338: Float parsing\nstrtod/ldexp\n\n✅ COMPLETE", fillcolor="#90EE90", style="filled,dashed"];
    }

    // Stubbed functions (partially complete)
    subgraph cluster_stubbed {
        label="Stubbed Functions ⚠️ PARTIALLY COMPLETE";
        style=filled;
        fillcolor="#FFF8E1";

        issue364 [label="#364: Stubbed functions\n(parent tracker)", fillcolor="#FFE4B5", style="bold"];

        // File metadata (complete for FAT32)
        subgraph cluster_metadata {
            label="File Metadata";
            style=filled;
            fillcolor="#E8FFE8";

            stat_done [label="✅ stat/fstat/lstat\n✅ access()\n✅ realpath()", fillcolor="#90EE90", style="filled,dashed"];
            issue366 [label="#366: Pseudo-fs metadata\ntmpfs/procfs/devfs\n\n3-4 weeks", fillcolor="#FFE4B5"];
            issue367 [label="#367: Rich FAT32 metadata\ntimestamps/DOS attrs\n\n2-3 weeks", fillcolor="#FFE4B5"];
        }

        // File mutation
        issue365 [label="#365: chmod/fchmod\n✅ COMPLETE", fillcolor="#90EE90", style="filled,dashed"];
        issue317 [label="#317: utime\nfile timestamps\n\n2-3 weeks", fillcolor="#FFE4B5"];

        // Other stubs
        issue368 [label="#368: Complete pathconf\nall POSIX queries\n\n1-2 weeks", fillcolor="#FFE4B5"];
        issue369 [label="#369: system()\nshell execution\n\n1-2 weeks", fillcolor="#FFE4B5"];
        issue363 [label="#363: Serial port FD\ndebug logging", fillcolor="#FFE4B5"];
    }

    // Userland tools (use stat infrastructure)
    subgraph cluster_userland_tools {
        label="Userland Tools";
        style=filled;
        fillcolor="#F0F8FF";

        issue370 [label="#370: stat command\n✅ COMPLETE", fillcolor="#90EE90", style="filled,dashed"];
        issue372 [label="#372: shutdown command\nClean ACPI power-off\n\n2-4 days", fillcolor="#E0F0FF"];
        issue373 [label="#373: realpath command\n✅ COMPLETE", fillcolor="#90EE90", style="filled,dashed"];
    }

    // Thread safety
    subgraph cluster_thread {
        label="Threading & Concurrency";
        style=filled;
        fillcolor="#E6F3FF";

        issue339 [label="#339: Thread-safe libc\nLocking & TLS\n\n6-8 weeks", fillcolor="#B3E5FC"];
    }

    // Extended features
    subgraph cluster_extended {
        label="Extended Features";
        style=filled;
        fillcolor="#FFF8E1";

        issue340 [label="#340: Extended stdio\npopen/tmpfile/setvbuf\n\n4-6 weeks", fillcolor="#FFE4B5"];
        issue344 [label="#344: Extended math\nsin/cos/exp/log\n\n12-16 weeks", fillcolor="#FFE4B5"];
        issue345 [label="#345: Regex\nregcomp/fnmatch\n\n10-14 weeks", fillcolor="#FFE4B5"];
        issue347 [label="#347: TTY helpers\nisatty/ttyname\n\n2-3 weeks", fillcolor="#FFE4B5"];
        issue348 [label="#348: Multiplexing\nselect/poll/epoll\n\n8-12 weeks", fillcolor="#FFE4B5"];
    }

    // Future work
    subgraph cluster_future {
        label="Future / Nice to Have";
        style=filled;
        fillcolor="#F0F0FF";

        issue341 [label="#341: Sockets\nsocket/bind/connect\n\n12+ weeks", fillcolor="#E6E6FA"];
        issue342 [label="#342: Locale/i18n\nsetlocale\n\n8-10 weeks", fillcolor="#E6E6FA"];
        issue343 [label="#343: Wide-char\nwchar_t/mbstate_t\n\n10-12 weeks", fillcolor="#E6E6FA"];
        issue346 [label="#346: Dynamic loader\ndlopen/dlsym\n\n16+ weeks", fillcolor="#E6E6FA"];
    }

    // Dependencies - Foundation
    issue193 -> issue304 [style=dashed, color=gray];
    issue193 -> issue305 [style=dashed, color=gray];
    issue193 -> issue306 [style=dashed, color=gray];
    issue193 -> issue307 [style=dashed, color=gray];
    issue193 -> issue308 [style=dashed, color=gray];
    issue193 -> issue309 [style=dashed, color=gray];
    issue193 -> issue310 [style=dashed, color=gray];

    // TCC blockers (now complete)
    issue213 -> issue337 [style=dashed, color=gray, label="kernel"];
    issue193 -> issue337 [style=dashed, color=gray];
    issue310 -> issue338 [style=dashed, color=gray, label="fabs"];
    issue193 -> issue338 [style=dashed, color=gray];

    // Stubbed functions dependencies
    issue193 -> issue364 [color=orange, penwidth=2];
    issue364 -> stat_done [style=dashed, color=green];
    issue364 -> issue366 [color=orange, label="HIGH"];
    issue364 -> issue367 [color=orange];
    issue364 -> issue365 [color=orange];
    issue364 -> issue317 [color=orange];
    issue364 -> issue368 [color=orange, style=dotted, label="LOW"];
    issue364 -> issue369 [color=orange];
    issue364 -> issue363 [color=orange, style=dotted];
    stat_done -> issue365 [color=brown, style=dashed, label="uses stat"];
    stat_done -> issue317 [color=brown, style=dashed, label="uses stat"];

    // Userland tools dependencies
    stat_done -> issue370 [color=green, penwidth=2, label="stat syscalls ✅"];
    issue193 -> issue370 [color=green, style=dashed, label="libc"];
    issue366 -> issue370 [color=blue, style=dotted, label="improves output"];
    issue367 -> issue370 [color=blue, style=dotted, label="improves output"];

    issue193 -> issue372 [color=green, style=dashed, label="libc"];
    issue213 -> issue372 [color=green, style=dotted, label="ACPI power button"];

    stat_done -> issue373 [color=green, penwidth=2, label="realpath() ✅"];
    issue193 -> issue373 [color=green, style=dashed, label="libc"];

    // Thread safety
    issue109 -> issue339 [color=blue, penwidth=2, label="pthread"];
    issue193 -> issue339 [color=blue];

    // Extended features
    issue193 -> issue340 [color=orange];
    issue208 -> issue340 [color=orange, label="for popen"];

    issue193 -> issue344 [color=orange];
    issue338 -> issue344 [color=orange, label="ldexp"];

    issue193 -> issue345 [color=orange];

    issue193 -> issue347 [color=brown];
    issue336 -> issue347 [color=brown, label="termios"];

    issue193 -> issue348 [color=brown];

    // Future
    issue193 -> issue341 [color=purple, style=dotted];
    issue193 -> issue342 [color=purple, style=dotted];
    issue193 -> issue343 [color=purple, style=dotted];
    issue193 -> issue346 [color=purple, style=dotted];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#F9F9F9";

        legend_complete [label="Complete ✅", fillcolor="#90EE90", style="filled,dashed"];
        legend_blocker [label="TCC Blocker ⚠️", fillcolor="#FFB6C1"];
        legend_thread [label="Threading", fillcolor="#B3E5FC"];
        legend_extended [label="Extended Features", fillcolor="#FFE4B5"];
        legend_future [label="Future", fillcolor="#E6E6FA"];
    }

    // Priority annotation
    subgraph cluster_priority {
        label="Implementation Priority";
        style=filled;
        fillcolor="#FFFACD";

        priority [label="✅ COMPLETE: Signal API (#337), Float parsing (#338)\n\nCURRENT PRIORITIES:\n1. Pseudo-fs metadata (#366) - HIGH (stat on tmpfs/devfs)\n2. stat command (#370) - MEDIUM (useful debugging tool, quick win)\n3. utime (#317) - MEDIUM (build systems)\n4. Rich FAT32 metadata (#367) - MEDIUM (timestamps)\n5. Thread-safe libc (#339) - After pthread\n6. system() (#369) - MEDIUM (utility scripts)\n7. TTY helpers (#347) - Quick win (2-3 weeks)\n8. pathconf (#368) - LOW (autoconf support)\n9. Extended stdio (#340) - Medium priority\n10. Extended math (#344) - Medium priority\n11. Regex (#345) - Needed for text tools\n12. Multiplexing (#348) - High for servers",
                 shape=note, fillcolor="#FFFACD", style=filled];
    }
}
