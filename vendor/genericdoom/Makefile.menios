# meniOS-specific build for doomgeneric using the meniOS SDK toolchain.
#
# The default target only compiles object files. Linking the full Doom
# binary is available via the `doom.elf` target but currently depends on
# libc work tracked in issues #305-#310.

ROOT_DIR        := $(abspath ../..)
MENIOS_GCC     ?= $(ROOT_DIR)/build/sdk/bin/menios-gcc

OBJDIR          := $(ROOT_DIR)/build/obj/usermode/doom
OUTPUT_DIR      := $(ROOT_DIR)/build/bin
TARGET          := $(OUTPUT_DIR)/doom.elf

CFLAGS         ?=
CFLAGS         += -DNORMALUNIX -DLINUX -DSNDSERV -D_DEFAULT_SOURCE
CFLAGS         += -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare
CFLAGS         += -msse2 -mfpmath=sse
CFLAGS         += -I.

LDFLAGS        ?=
LDFLAGS        += -lm

SRCS := \
	am_map.c \
	dummy.c \
	doomdef.c \
	doomstat.c \
	dstrings.c \
	d_event.c \
	d_items.c \
	d_iwad.c \
	d_loop.c \
	d_main.c \
	d_mode.c \
	d_net.c \
	f_finale.c \
	f_wipe.c \
	g_game.c \
	hu_lib.c \
	hu_stuff.c \
	info.c \
	i_cdmus.c \
	i_endoom.c \
	i_input.c \
	i_joystick.c \
	i_scale.c \
	i_sound.c \
	i_system.c \
	i_timer.c \
	i_video.c \
	memio.c \
	m_argv.c \
	m_bbox.c \
	m_cheat.c \
	m_config.c \
	m_controls.c \
	m_fixed.c \
	m_menu.c \
	m_misc.c \
	m_random.c \
	p_ceilng.c \
	p_doors.c \
	p_enemy.c \
	p_floor.c \
	p_inter.c \
	p_lights.c \
	p_map.c \
	p_maputl.c \
	p_mobj.c \
	p_plats.c \
	p_pspr.c \
	p_saveg.c \
	p_setup.c \
	p_sight.c \
	p_spec.c \
	p_switch.c \
	p_telept.c \
	p_tick.c \
	p_user.c \
	r_bsp.c \
	r_data.c \
	r_draw.c \
	r_main.c \
	r_plane.c \
	r_segs.c \
	r_sky.c \
	r_things.c \
	sha1.c \
	sounds.c \
	statdump.c \
	st_lib.c \
	st_stuff.c \
	s_sound.c \
	tables.c \
	v_video.c \
	wi_stuff.c \
	w_checksum.c \
	w_file.c \
	w_file_stdc.c \
	w_main.c \
	w_wad.c \
	z_zone.c \
	doomgeneric.c \
	doomgeneric_menios.c \
	mus2mid.c

OBJS := $(addprefix $(OBJDIR)/,$(SRCS:.c=.o))

.PHONY: all clean print doom doom-objs install

all: $(TARGET)

doom: $(TARGET)

doom-objs: $(OBJS)

install: $(TARGET)

$(OBJDIR):
	@mkdir -p "$(OBJDIR)"

$(OUTPUT_DIR):
	@mkdir -p "$(OUTPUT_DIR)"

$(OBJDIR)/%.o: %.c | $(OBJDIR)
	@echo "[DOOM] CC $<"
	$(MENIOS_GCC) -c $(CFLAGS) $< -o $@

$(TARGET): $(OBJS) | $(OUTPUT_DIR)
	@echo "[DOOM] LD $@"
	$(MENIOS_GCC) $(OBJS) $(LDFLAGS) -o $@
	@mkdir -p "$(OUTPUT_DIR)/bin"
	@cp "$@" "$(OUTPUT_DIR)/bin/doom"

clean:
	rm -rf "$(OBJDIR)"
	rm -f "$(TARGET)"

print:
	@echo SRCS=$(SRCS)
	@echo OBJS=$(OBJS)
